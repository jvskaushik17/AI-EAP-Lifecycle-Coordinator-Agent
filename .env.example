# Meeting Notes Agent — environment variables
# Copy this file to .env and fill in your values.

# Anthropic API key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Azure AD app registration (same one used for the EAP agent)
# See SETUP_AGENT.md for how to create/find these values.
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here

# OneDrive folder to scan (default shown — change if needed)
# ONEDRIVE_FOLDER=Documents/Meeting notes
